# Copy to .env and fill in. Tracked template — no real secrets here.
NODE_ENV=development
PORT=3000

# Nest / TypeORM connection. Host port from DATABASE_PORT: 5432 is held by a native Postgres install.
DATABASE_HOST=localhost
DATABASE_PORT=5437
DATABASE_USER=change-me
DATABASE_PASSWORD=change-me
DATABASE_NAME=change-me
DATABASE_SCHEMA=public


# Comma-separated allowed origins, or * for any.
CORS_ORIGINS=http://localhost:3001
# Swagger UI at /docs. Set false in production.
SWAGGER_ENABLED=true

# Session JWT. JWT_SECRET has no default: an unset value kills the boot.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Root directory for stored files. No default: an unset value kills the boot.
# The DB stores keys relative to this, so the directory can move freely.
FILE_STORAGE_PATH=./storage

# OpenAI-compatible AI provider, used to summarise context documents and propose
# knowledge blocks. All four are REQUIRED with no code default — the backend will
# not boot without them. Reference provider: OpenRouter (https://openrouter.ai/api/v1).
# NEVER COMMIT A REAL KEY.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=change-me
AI_MODEL_FAST=anthropic/claude-haiku-4.5
AI_MODEL_STRONG=anthropic/claude-sonnet-4.5

# Seed account created by `pnpm seed`. Read only by the seed script.
SEED_ADMIN_EMAIL=admin@clarivo.local
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Change Me

# Optional second account, an OPTIONAL local test fixture for the member-vs-owner
# project states. Seeded only when all three are set. Never commit a real password.
SEED_MEMBER_EMAIL=
SEED_MEMBER_PASSWORD=
SEED_MEMBER_NAME=
